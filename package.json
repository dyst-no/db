{
  "name": "@dyst-no/db",
  "version": "0.1.3",
  "description": "Database CLI and helpers for Dyst projects.",
  "keywords": [
    "database",
    "postgres",
    "migrations",
    "seed",
    "typescript"
  ],
  "homepage": "https://github.com/dyst-no/db#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyst-no/db.git"
  },
  "bugs": {
    "url": "https://github.com/dyst-no/db/issues"
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dyst-db": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome check --write --error-on-warnings .",
    "typecheck": "tsc --pretty false --noEmit",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "peerDependencies": {
    "zod": "^4.3.5",
    "dotenv": "^16.4.7",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/bun": "latest",
    "@types/node": "^20.11.30",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "postgres": "^3.4.5",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  }
}
